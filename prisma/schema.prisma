generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Access level. Job title (PM / Toll / Maintenance / Corridor) lives on the
// assignment rows, not here: one person can hold different jobs per site.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(MANAGER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectAssignments ProjectAssignment[]
  plazaAssignments   PlazaAssignment[]
  assignedTasks      Task[]              @relation("Assignee")
  createdTasks       Task[]              @relation("Creator")
  events             TaskEvent[]

  @@index([role])
  @@index([active])
}

enum Role {
  ADMIN
  MANAGEMENT
  MANAGER
}

model Project {
  id        String       @id @default(cuid())
  name      String
  acronym   String?
  round     Round
  status    MasterStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  plazas      Plaza[]
  assignments ProjectAssignment[]

  // Canonical identity after Excel cleaning (see scripts/parse-nhit.py:
  // AS folds into Palanpur, Amravati x3 merges). Acronym stays non-unique
  // (AAN x3, RSB x2) and is display/search only.
  @@unique([name, round])
  @@index([round])
  @@index([status])
  @@index([acronym])
}

enum Round {
  ROUND_1
  ROUND_2
  ROUND_3
  ROUND_4
}

enum MasterStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

model Plaza {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name      String
  state     String?
  piu       String?
  ro        String?
  lengthKm  Float?
  status    MasterStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  assignments PlazaAssignment[]
  tasks       Task[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([status])
}

// Project team. Role is always PROJECT_MANAGER (one primary per project).
model ProjectAssignment {
  projectId    String
  userId       String
  isPrimary    Boolean  @default(false)
  assignedById String?
  assignedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// Plaza team + access control. PK includes role so one user can hold
// several jobs on the same plaza. Vacant post = no row.
model PlazaAssignment {
  plazaId      String
  userId       String
  role         PlazaRole
  isPrimary    Boolean   @default(false)
  assignedById String?
  assignedAt   DateTime  @default(now())

  plaza Plaza @relation(fields: [plazaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([plazaId, userId, role])
  @@index([plazaId])
  @@index([userId])
}

enum PlazaRole {
  TOLL
  MAINTENANCE
  CORRIDOR
}

model Task {
  id          String     @id @default(cuid())
  plazaId     String
  plaza       Plaza      @relation(fields: [plazaId], references: [id], onDelete: Restrict)
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  assigneeId  String?
  assignee    User?      @relation("Assignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User       @relation("Creator", fields: [createdById], references: [id])
  dueDate     DateTime?  @db.Date
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  events      TaskEvent[]

  @@index([plazaId, status])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([plazaId])
  @@index([status])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model TaskEvent {
  id         String      @id @default(cuid())
  taskId     String
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actorId    String
  actor      User        @relation(fields: [actorId], references: [id])
  type       EventType
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  text       String?
  createdAt  DateTime    @default(now())

  @@index([taskId, createdAt])
  @@index([actorId])
}

enum EventType {
  CREATED
  STATUS
  ASSIGN
  COMMENT
  REOPEN
  META
}
