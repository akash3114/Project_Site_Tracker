generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Conventions
//
// * Generated rows use cuid(). Reference/catalogue rows (departments, offices,
//   categories, companies) use stable slugs such as `dept_fin`, so every
//   environment is identical. The seed owns catalogue ids; migrations do not
//   insert them.
// * Timestamps are `timestamptz(3)`; calendar dates are `date`.
// * People are never deleted, so every user reference is `onDelete: Restrict`.
// * Master data is archived with `active = false`, never deleted while in use.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// People and access
//
// There is no fixed account role. Access is derived from assignments:
//   - User.isAdmin                    -> platform administrator
//   - HeadOfficeMembership            -> head office, all projects everywhere
//   - ProjectAssignment(PROJECT_MANAGER) -> project manager
//   - PlazaAssignment(TOLL|MAINTENANCE|CORRIDOR) -> site manager
// A person may hold several assignments at once.
//
// Head Office is an internal dimension, not a scope level under Company:
// departments are organisational metadata only and gate nothing. Each person
// with a department holds exactly one primary department (partial unique
// index, see the migration). Office is where the person sits.
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  // Optional job title, e.g. "Operations Manager". When set it overrides the
  // derived role label in assignee pickers and the header.
  title        String?
  passwordHash String
  isAdmin      Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id], onDelete: SetNull)

  // Reporting line. Managers see, comment on and change the status of work
  // owned by anyone below them, on top of the normal scope visibility.
  managerId String?
  manager   User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("UserManager")

  headOfficeMemberships HeadOfficeMembership[]
  projectAssignments    ProjectAssignment[]
  plazaAssignments      PlazaAssignment[]

  taskAssignments     TaskAssignee[] @relation("TaskAssigneeUser")
  taskAssignmentsMade TaskAssignee[] @relation("TaskAssigneeAssigner")
  createdTasks        Task[]         @relation("Creator")
  completedTasks      Task[]         @relation("Completer")

  activities TaskActivity[] @relation("ActivityActor")

  fromAssigneeActivities TaskActivity[] @relation("ActivityFromAssignee")
  toAssigneeActivities   TaskActivity[] @relation("ActivityToAssignee")

  reopenRequested TaskReopenRequest[] @relation("ReopenRequester")
  reopenReviewed  TaskReopenRequest[] @relation("ReopenReviewer")

  attachments TaskAttachment[]

  auditLogs AuditLog[]

  @@index([isAdmin])
  @@index([active, name])
  @@index([managerId])
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  projects Project[]

  @@index([active, name])
}

// ---------------------------------------------------------------------------
// Head Office structure
//
// A department membership IS the Head Office grant. Departments are a global
// catalogue shared by every company and affect permissions not at all. They
// are also a task location: Task.departmentId scopes a task to a department,
// with departmentId = null meaning Head Office level.
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(cuid())
  name      String   @unique // "Finance & Accounts"
  code      String   @unique // "FIN"
  sortOrder Int      @default(0) // Sr.No. from the source list
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members HeadOfficeMembership[]
  tasks   Task[]

  @@index([active, sortOrder])
}

model Office {
  id        String   @id @default(cuid())
  name      String   @unique // "Delhi"
  city      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users User[]
}

model HeadOfficeMembership {
  userId       String
  departmentId String
  isPrimary    Boolean  @default(false)
  assignedById String?
  assignedAt   DateTime @default(now()) @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
}

model Project {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  acronym   String?
  round     Round
  state     String?
  lengthKm  Float?
  piu       String?
  ro        String?
  // Soft archive only. Projects never complete.
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  plazas      Plaza[]
  assignments ProjectAssignment[]
  tasks       Task[]

  @@unique([companyId, name])
  @@index([companyId, active, round])
  @@index([round])
  @@index([acronym])
}

enum Round {
  ROUND_1
  ROUND_2
  ROUND_3
  ROUND_4
}

model Plaza {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name      String
  // Location metadata (state, PIU, RO) lives on the project; only the plaza
  // bracket length is plaza-specific.
  lengthKm  Float?
  // Soft archive only. Plazas never complete.
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  assignments PlazaAssignment[]
  tasks       Task[]

  @@unique([projectId, name])
  @@index([projectId, active])
}

model ProjectAssignment {
  projectId    String
  userId       String
  isPrimary    Boolean  @default(false)
  assignedById String?
  assignedAt   DateTime @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model PlazaAssignment {
  plazaId      String
  userId       String
  role         PlazaRole
  isPrimary    Boolean   @default(false)
  assignedById String?
  assignedAt   DateTime  @default(now()) @db.Timestamptz(3)

  plaza Plaza @relation(fields: [plazaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([plazaId, userId, role])
  @@index([plazaId])
  @@index([userId])
}

enum PlazaRole {
  TOLL
  MAINTENANCE
  CORRIDOR
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model TaskCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tasks Task[]

  @@index([active, name])
}

model Task {
  id            String        @id @default(cuid())
  // A task belongs to exactly one scope. `scope` is the discriminator; the
  // matching column(s) are enforced by a CHECK constraint in the migration
  // because Prisma cannot express it.
  scope         TaskScopeKind
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  plazaId       String?
  plaza         Plaza?        @relation(fields: [plazaId], references: [id], onDelete: Restrict)
  departmentId  String?
  department    Department?   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  categoryId    String?
  category      TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  status        TaskStatus    @default(TODO)
  priority      Priority      @default(MEDIUM)
  createdById   String
  createdBy     User          @relation("Creator", fields: [createdById], references: [id], onDelete: Restrict)
  dueDate       DateTime?     @db.Date
  completedAt   DateTime?     @db.Timestamptz(3)
  completedById String?
  completedBy   User?         @relation("Completer", fields: [completedById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  assignees      TaskAssignee[]
  activities     TaskActivity[]
  attachments    TaskAttachment[]
  reopenRequests TaskReopenRequest[]

  @@index([projectId, status, dueDate])
  @@index([plazaId, status, dueDate])
  @@index([departmentId, status, dueDate])
  @@index([scope, status, dueDate])
  @@index([categoryId])
  @@index([dueDate])
  @@index([status])
  @@index([createdById])
  @@index([completedById])
  @@index([updatedAt])
}

// Many-to-many task ownership. Every assignee has the same rights: the task is
// visible on their board and any of them may move its status or comment.
// The creator and anyone above the assignees (role or reporting line) keep
// their own rights.
model TaskAssignee {
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("TaskAssigneeUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedById String?
  assignedBy   User?    @relation("TaskAssigneeAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([taskId, userId])
  @@index([userId, taskId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum TaskScopeKind {
  PROJECT
  PLAZA
  DEPARTMENT
  HEAD_OFFICE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Immutable task history. Comments are activity rows too, so the feed and
// the audit trail are the same append-only stream.
model TaskActivity {
  id             String           @id @default(cuid())
  taskId         String
  task           Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId        String
  actor          User             @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  type           TaskActivityType
  fromStatus     TaskStatus?
  toStatus       TaskStatus?
  fromAssigneeId String?
  fromAssignee   User?            @relation("ActivityFromAssignee", fields: [fromAssigneeId], references: [id], onDelete: Restrict)
  toAssigneeId   String?
  toAssignee     User?            @relation("ActivityToAssignee", fields: [toAssigneeId], references: [id], onDelete: Restrict)
  text           String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  attachments TaskAttachment[]

  @@index([taskId, createdAt])
  @@index([actorId])
  @@index([type])
}

enum TaskActivityType {
  CREATED
  COMMENT
  ASSIGNED
  STATUS_CHANGED
  REOPEN_REQUESTED
  REOPEN_APPROVED
  REOPEN_REJECTED
  REOPEN_CANCELLED
  REOPENED
  ATTACHMENT
  UPDATED
}

model TaskAttachment {
  id           String        @id @default(cuid())
  taskId       String
  task         Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  activityId   String?
  activity     TaskActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  fileName     String
  storedName   String        @unique
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@index([taskId])
  @@index([activityId])
}

model TaskReopenRequest {
  id            String              @id @default(cuid())
  taskId        String
  task          Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                @relation("ReopenRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById  String?
  reviewedBy    User?               @relation("ReopenReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  status        ReopenRequestStatus @default(PENDING)
  reason        String
  reviewNote    String?
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  reviewedAt    DateTime?           @db.Timestamptz(3)

  @@index([taskId, status])
  @@index([requestedById])
  @@index([status])
}

enum ReopenRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Master-data audit
//
// Task history lives in TaskActivity (the feed and the task audit trail are the
// same stream). Every other master-data mutation — companies, projects,
// plazas, users, categories, assignments — is recorded here, one row per
// change, with a before/after snapshot. Append-only: no update or delete API.
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  // Logical table name, e.g. "Company", "Project", "Plaza", "User",
  // "TaskCategory", "HeadOfficeMembership", "ProjectAssignment",
  // "PlazaAssignment".
  entity    String
  entityId  String
  // CREATE | UPDATE | ARCHIVE | GRANT | REVOKE
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
